generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String     @id @default(uuid())
  username  String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  character Character?
}

model Character {
  id              String              @id @default(uuid())
  name            String
  appearanceColor String
  avatar          String              @default("bunny")
  description     String?
  wallet          Int                 @default(1000)
  arenaMaxRounds  Int                 @default(0)
  loanStatus      CharacterLoanStatus @default(NONE)
  loanLockedUntil DateTime?
  userId          String              @unique
  buildings       BuildingState[]
  user            User                @relation(fields: [userId], references: [id])
  portfolio       PortfolioItem[]
  loans           CharacterLoan[]
  loanRepayments  LoanRepayment[]
  loanOperations  LoanOperation[]
}

model BuildingState {
  id        String     @id
  townId    String
  title     String?
  forSale   Boolean    @default(true)
  price     Int        @default(5000)
  employees Int        @default(0)
  ownerId   String?
  owner     Character? @relation(fields: [ownerId], references: [id])
}

model Town {
  id                   Int                  @id @default(autoincrement())
  name                 String
  bankBalance          Int                  @default(0)
  treasurySnapshots    TreasuryDaySnapshot[]
  treasuryLedgerEntries TreasuryLedgerEntry[]
  characterLoans       CharacterLoan[]
}

model GameState {
  id        String   @id @default(uuid())
  state     String
  updatedAt DateTime @updatedAt
}

model Stock {
  id            String          @id @default(uuid())
  symbol        String          @unique
  name          String
  price         Float           @default(100.0)
  previousPrice Float           @default(100.0)
  updatedAt     DateTime        @updatedAt
  portfolio     PortfolioItem[]
  history       StockHistory[]
}

model StockHistory {
  id        String   @id @default(uuid())
  stockId   String
  price     Float
  timestamp DateTime @default(now())
  stock     Stock    @relation(fields: [stockId], references: [id])
}

model PortfolioItem {
  id          String    @id @default(uuid())
  characterId String
  stockId     String
  quantity    Int       @default(0)
  stock       Stock     @relation(fields: [stockId], references: [id])
  character   Character @relation(fields: [characterId], references: [id])

  @@unique([characterId, stockId])
}

enum CharacterLoanStatus {
  NONE
  ACTIVE
  DELINQUENT
}

enum TreasuryLedgerKind {
  BUILDING_SALE_INFLOW
  LOAN_PRINCIPAL_OUTFLOW
  LOAN_REPAYMENT_PRINCIPAL_INFLOW
  LOAN_INTEREST_INFLOW
  LOAN_FEE_INFLOW
  DAILY_VARIATION
  ADMIN_ADJUSTMENT
}

enum LoanStatus {
  ACTIVE
  DELINQUENT
  PAID
  DEFAULTED
  FORGIVEN
}

enum LoanPaymentSource {
  MANUAL
  AUTO_SWEEP
  FORCED_LIQUIDATION
}

enum LoanOperationType {
  ISSUE
  REPAY
}

model TreasuryLedgerEntry {
  id            String           @id @default(uuid())
  townId        Int
  kind          TreasuryLedgerKind
  amount        Int
  referenceType String
  referenceId   String
  metadataJson  String?
  createdAt     DateTime         @default(now())

  town Town @relation(fields: [townId], references: [id])

  @@index([townId, createdAt])
  @@index([referenceType, referenceId])
}

model TreasuryDaySnapshot {
  id              String   @id @default(uuid())
  townId          Int
  dateKey         String
  openingBalance  Int
  variationAmount Int
  loanNetAmount   Int      @default(0)
  otherNetAmount  Int      @default(0)
  closingBalance  Int
  processedAt     DateTime @default(now())

  town Town @relation(fields: [townId], references: [id])

  @@unique([townId, dateKey])
}

model CharacterLoan {
  id                         String      @id @default(uuid())
  characterId                String
  townId                     Int
  status                     LoanStatus  @default(ACTIVE)
  principalOrigin            Int
  remainingPrincipal         Int
  aprBps                     Int
  dailyInterestBps           Int
  lateFeesAccrued            Int         @default(0)
  issuedAt                   DateTime    @default(now())
  dueAt                      DateTime
  lastInterestAccrualDateKey String
  missedPaymentDays          Int         @default(0)
  nextDueDateKey             String
  version                    Int         @default(0)

  character Character       @relation(fields: [characterId], references: [id])
  town      Town            @relation(fields: [townId], references: [id])
  repayments LoanRepayment[]
  operations LoanOperation[]

  @@index([characterId, status])
}

model LoanRepayment {
  id              String            @id @default(uuid())
  loanId          String
  characterId     String
  amountPaid      Int
  appliedFees     Int
  appliedInterest Int
  appliedPrincipal Int
  paymentSource   LoanPaymentSource
  createdAt       DateTime          @default(now())

  loan      CharacterLoan @relation(fields: [loanId], references: [id])
  character Character     @relation(fields: [characterId], references: [id])
}

model LoanOperation {
  id             String            @id @default(uuid())
  idempotencyKey String            @unique
  operationType  LoanOperationType
  responseJson   String
  characterId    String
  loanId         String?
  createdAt      DateTime          @default(now())

  character Character      @relation(fields: [characterId], references: [id])
  loan      CharacterLoan? @relation(fields: [loanId], references: [id])
}
