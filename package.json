{
  "name": "bbtown-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev:web": "npm run dev --workspace web",
    "build:web": "npm run build --workspace web",
    "start:web": "npm run start --workspace web",
    "test:web": "npm run test --workspace web",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "cms:up": "docker compose up -d cms",
    "cms:logs": "docker compose logs -f cms",
    "seed:towns:strapi": "node_modules/.bin/tsx scripts/seed-towns-to-strapi.ts",
    "seed:buildings:strapi": "node_modules/.bin/tsx scripts/seed-buildings-to-strapi.ts",
    "seed:building-states:strapi": "node_modules/.bin/tsx scripts/seed-building-states-to-strapi.ts",
    "seed:stocks:strapi": "node_modules/.bin/tsx scripts/seed-stocks-to-strapi.ts",
    "seed:stock-history:strapi": "node_modules/.bin/tsx scripts/seed-stock-history-to-strapi.ts",
    "seed:portfolio:strapi": "node_modules/.bin/tsx scripts/seed-portfolio-to-strapi.ts",
    "check:market-sync": "node_modules/.bin/tsx scripts/check-market-sync.ts",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down"
  }
}
