{
  "kind": "collectionType",
  "collectionName": "market_company_profiles",
  "info": {
    "singularName": "market-company-profile",
    "pluralName": "market-company-profiles",
    "displayName": "Market Company Profile",
    "description": "CMS source for market metadata by symbol"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "symbol": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "sector": {
      "type": "string"
    },
    "exchange": {
      "type": "string"
    },
    "marketCapBand": {
      "type": "enumeration",
      "enum": ["SMALL", "MID", "LARGE"],
      "default": "MID"
    },
    "volatilityClass": {
      "type": "enumeration",
      "enum": ["LOW", "MEDIUM", "HIGH"],
      "default": "MEDIUM"
    },
    "description": {
      "type": "text"
    },
    "hqRegion": {
      "type": "string"
    },
    "basePrice": {
      "type": "decimal"
    },
    "displayOrder": {
      "type": "integer",
      "default": 100
    }
  }
}
